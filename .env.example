# Public URL served through the Cloudflare tunnel (must be https)
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=change-me-openssl-rand-base64-32

# Postgres runs on the HOST (not in Docker); containers reach it via host.docker.internal
DATABASE_URL=postgresql://nosploit:change-me@host.docker.internal:5432/nosploit

# OAuth apps (callbacks: {NEXTAUTH_URL}/api/auth/callback/discord and /roblox)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# Public links
NEXT_PUBLIC_ROBLOX_GROUP_URL=https://www.roblox.com/communities/0/Nosploit
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/your-invite

# First CEO account (whitelisted on seed). Set at least one.
INITIAL_CEO_DISCORD_ID=
INITIAL_CEO_ROBLOX_ID=
INITIAL_CEO_NAME=CEO

# Optional: if set, /api/v1/licenses/verify requires "Authorization: Bearer <token>"
LICENSE_API_TOKEN=
